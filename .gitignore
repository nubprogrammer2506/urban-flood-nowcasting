# ==========================================
# Python
# ==========================================
.venv/
__pycache__/
*.pyc
*.pyo

# ==========================================
# Environment / secrets
# ==========================================
.env
.env.*

# ==========================================
# IDE
# ==========================================
.vscode/
.idea/

# ==========================================
# Operating system
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# QGIS temporary / metadata files
# ==========================================
*.qgz~
*.qgs~
*.aux.xml
*.ovr

data/raw/aoi/*.qmd
data/raw/aoi/*.qgz

# ==========================================
# Raw DEM data
# ==========================================
data/raw/dem/*.tif
data/raw/dem/*.tar.gz
data/raw/dem/*.zip
data/raw/dem/*.aux.xml

# ==========================================
# Large rainfall / land-use rasters
# ==========================================
data/raw/rainfall/*
data/raw/landuse/*.tif

# ==========================================
# Generated GIS outputs
# ==========================================
data/processed/**/*.tif
data/processed/**/*.tfw
data/processed/**/*.aux.xml

data/outputs/*

# ==========================================
# Preserve directory placeholders
# ==========================================
!data/processed/**/.gitkeep
!data/outputs/**/.gitkeep


# OSMnx cache
cache/

# Reproducible road GIS files
data/raw/roads/*.gpkg
data/processed/roads/*.gpkg

# Generated NetworkX graph
data/processed/roads/*.graphml

# Canonical processed road dataset is committed
!data/processed/roads/
!data/processed/roads/roads.geojson
!data/processed/roads/.gitkeep