# Python
.venv/
__pycache__/
*.pyc

# Environment
.env

# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# QGIS temporary files
*.qgz~
*.qgs~
*.aux.xml
*.ovr

# Large GIS inputs
data/raw/dem/*.tif
data/raw/rainfall/*
data/raw/landuse/*.tif

# Keep rainfall folder placeholder
!data/raw/rainfall/.gitkeep

# Generated GIS data
data/processed/*
data/outputs/*

# Allow folder structure to exist
!data/processed/**/
!data/outputs/**/

# Preserve placeholders
!data/processed/**/.gitkeep
!data/outputs/**/.gitkeep

# ==============================
# GIS generated raster outputs
# ==============================
data/processed/**/*.tif
data/processed/**/*.tfw
data/processed/**/*.aux.xml

# ==============================
# Raw DEM datasets / archives
# ==============================
data/raw/dem/*.tif
data/raw/dem/*.tar.gz
data/raw/dem/*.zip
data/raw/dem/*.aux.xml

# ==============================
# QGIS metadata / local projects
# ==============================
data/raw/aoi/*.qmd
data/raw/aoi/*.qgz